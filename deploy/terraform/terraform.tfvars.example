# Copy to terraform.tfvars (ignored by git) and fill in. DEPLOY.md, "One-time setup", step 4.
alert_email = "you@example.com" # budget alerts and Let's Encrypt notices

# Once you have a domain (DEPLOY.md, "Adding a domain"):
# domain          = "play.example.com"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Rarely changed:
# region        = "eu-west-2"
# instance_type = "t4g.small"
# cpu_credits   = "standard"   # "unlimited" keeps full speed when busy, and AWS charges for it
# budget_usd    = 25
