#!/bin/bash
# First boot of the Auld World server (Amazon Linux 2023). Everything after this comes from deploys (deploy/host/deploy.sh, run by CI).
# The log of this script: /var/log/auld-setup.log
set -euo pipefail
exec > /var/log/auld-setup.log 2>&1
echo "[setup] $(date -u) starting"

# swap: room to breathe when two matches overlap on a small server
if [ ! -f /swapfile ] && [ "${swap_gb}" -gt 0 ]; then
  fallocate -l "${swap_gb}G" /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
  echo 'vm.swappiness=10' > /etc/sysctl.d/90-auld.conf && sysctl --system >/dev/null
fi

# what deploys need to know, and the deploy script itself
mkdir -p /etc/auld /opt/auld /var/lib/auld/caddy
echo "${bucket}" > /etc/auld/bucket
echo "${region}" > /etc/auld/region
echo "${deploy_sh_b64}" | base64 -d > /opt/auld/deploy.sh
chmod 755 /opt/auld/deploy.sh

# k3s, pinned; without the parts we do not use (Traefik: Caddy is the front door; servicelb: Caddy holds the ports; metrics-server: memory)
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION='${k3s_version}' INSTALL_K3S_EXEC='server --disable traefik --disable servicelb --disable metrics-server --write-kubeconfig-mode 600' sh -
for i in $(seq 1 60); do /usr/local/bin/kubectl get nodes 2>/dev/null | grep -q ' Ready' && break; sleep 5; done
/usr/local/bin/kubectl get nodes
echo "[setup] $(date -u) done: waiting for the first deploy"
